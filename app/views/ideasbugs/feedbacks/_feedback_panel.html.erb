<section class="detail-panel">
  <div class="panel-head">
    <h1>
      <span class="badge kind-<%= feedback.kind.to_s.parameterize %>">
        <%= t("ideasbugs.kinds.#{feedback.kind}", default: feedback.kind.humanize) %>
      </span>
      <span class="case-id">#<%= feedback.to_param %></span>
    </h1>

    <%# The shared status switch, carrying the status the heading badge used to
        state: the current one is lit and inert, every other one is a submit
        that files the report under it. One form, no JS. %>
    <%= form_with url: feedback_path(feedback), method: :patch, class: 'status-switch' do %>
      <% Ideasbugs::Feedback::STATUSES.each do |status| %>
        <% label = t("ideasbugs.statuses.#{status}", default: status.humanize) %>
        <% if status == feedback.status %>
          <button type="button" class="status-<%= status %> current" aria-current="true"><%= label %></button>
        <% else %>
          <button name="feedback[status]" value="<%= status %>" class="status-<%= status %>"
                  aria-label="<%= t("ideasbugs.dashboard.move_to_#{status}", default: "Mark #{status.humanize.downcase}") %>">
            <%= label %>
          </button>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="detail-scroll">
    <div class="card pad">
      <dl>
        <% if feedback.section.present? %>
          <dt><%= t('ideasbugs.section', default: 'Section') %></dt>
          <dd><%= feedback.section %></dd>
        <% end %>
        <% if feedback.author_label.present? || feedback.author_id.present? %>
          <dt><%= t('ideasbugs.dashboard.from', default: 'From') %></dt>
          <dd><%= feedback.author_label.presence || "##{feedback.author_id}" %></dd>
        <% end %>
        <% if feedback.page_url.present? %>
          <dt><%= t('ideasbugs.dashboard.page', default: 'Page') %></dt>
          <dd><%= link_to feedback.page_url, feedback.page_url, target: '_blank', rel: 'noopener' %></dd>
        <% end %>
        <% if feedback.user_agent.present? %>
          <dt><%= t('ideasbugs.dashboard.browser', default: 'Browser') %></dt>
          <dd class="muted"><%= feedback.user_agent %></dd>
        <% end %>
        <dt><%= t('ideasbugs.dashboard.filed', default: 'Filed') %></dt>
        <dd><%= feedback.created_at %></dd>
      </dl>
    </div>

    <div class="card pad">
      <p class="message"><%= feedback.message %></p>

      <% if feedback.screenshots? %>
        <div class="shots">
          <% feedback.screenshots.each do |screenshot| %>
            <%= link_to feedback_screenshot_path(feedback, screenshot.id), target: '_blank', rel: 'noopener' do %>
              <%= image_tag feedback_screenshot_path(feedback, screenshot.id), alt: screenshot.filename %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Status lives in the switch in the heading; only what a switch cannot say
        is left here. %>
    <section class="card pad">
      <h2>Moderation</h2><p><%= feedback.board.name %> · <%= feedback.visibility.humanize %></p>
      <% unless feedback.visibility == 'merged' %>
        <%= button_to(feedback.visibility == 'listed' ? 'Unlist request' : 'List request', feedback_path(feedback), method: :patch, params: { feedback: { visibility: feedback.visibility == 'listed' ? 'unlisted' : 'listed' } }) %>
      <% end %>
      <% if feedback.visibility == 'listed' %>
        <p><%= link_to 'Open customer discussion', board_item_path(feedback.board, feedback) %></p>
        <%= form_with url: merge_feedback_path(feedback), method: :post do |f| %><%= f.label :target_id, 'Merge into request ID' %><%= f.text_field :target_id, required: true %><%= f.submit 'Merge duplicate' %><% end %>
      <% end %>
      <h3>Voters (<%= feedback.votes_count %>)</h3><ul><% feedback.votes.order(:id).limit(100).each do |vote| %><li><%= vote.voter_label %></li><% end %></ul>
      <h3>Comments</h3><% feedback.comments.order(:id).limit(100).each do |comment| %><article><strong><%= comment.author_label %></strong><%= simple_format h(comment.body) %><%= button_to 'Delete comment and replies', feedback_comment_path(feedback, comment_id: comment.id), method: :delete %></article><% end %>
    </section>
    <div class="actions">
      <%= button_to t('ideasbugs.dashboard.delete', default: 'Delete'),
                    feedback_path(feedback),
                    method: :delete, class: 'danger',
                    form: { onsubmit: "return confirm('#{t('ideasbugs.dashboard.delete_confirm', default: 'Delete this feedback?')}')" } %>
    </div>
  </div>
</section>
